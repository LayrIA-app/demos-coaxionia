  function phdr(title,bcls,btxt,sub){return '<div class="page-hdr"><div class="page-hdr-line"><h2>'+title+'</h2><span class="badge '+bcls+'">'+btxt+'</span></div><p>'+sub+'</p></div>';}
  function scr(id,active,content){return '<div class="screen'+(active?' active':'')+'" id="screen-'+id+'">'+content+'</div>';}
  function row2(a,b){return '<div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--border)"><span style="font-size:.72rem;color:var(--text2)">'+a+'</span><span style="font-size:.72rem;font-weight:600;color:var(--navy)">'+b+'</span></div>';}

  /* 1 — MI PROYECTO EN TIEMPO REAL */
  var fases=[
    {n:'Fase 0 - Kick-off y diagnostico',estado:'Completado',b:'b-ok',fecha:'3 mar',p:100},
    {n:'Fase 1 - Quick wins operativos',estado:'Completado',b:'b-ok',fecha:'28 mar',p:100},
    {n:'Fase 2 - Implantacion IA',estado:'En curso',b:'b-amber',fecha:'En curso',p:65},
