var _readAlerts={};
function initAlerts(role){
  _readAlerts={};
  updateBadge(role);
  renderAlerts(role);
}
function updateBadge(role){
  var alerts=alertsData[role]||[];
  var unread=alerts.filter(function(a,i){return !_readAlerts[i];}).length;
  var badge=document.getElementById('bellBadge');
  if(badge){badge.textContent=unread;badge.style.display=unread>0?'flex':'none';}
  var countEl=document.getElementById('alertsCount');
  if(countEl)countEl.textContent=unread+' alerta'+(unread!==1?'s sin leer':'sin leer');
}
function renderAlerts(role){
  var body=document.getElementById('alertsBody');
  if(!body)return;
  var alerts=alertsData[role]||[];
  updateBadge(role);
  var groups={};
  alerts.forEach(function(a,i){
    if(!groups[a.sec])groups[a.sec]=[];
    groups[a.sec].push({a:a,i:i});
  });
  var html='';
  Object.keys(groups).forEach(function(sec){
    html+='<div class="alert-group-title">'+sec+'</div>';
    groups[sec].forEach(function(obj){
      var read=_readAlerts[obj.i]?'opacity:.4;':'';
      html+='<div class="alert-item" onclick="markRead('+obj.i+')" style="cursor:pointer;'+read+'">'
        +'<div class="alert-dot '+obj.a.tipo+'"></div>'
        +'<div class="alert-txt">'+obj.a.txt+'</div>'
        +'</div>';
    });
  });
  body.innerHTML=html||'<div style="padding:20px;text-align:center;color:#94A3B8;font-size:.78rem">Sin alertas activas</div>';
}
function markRead(idx){
  _readAlerts[idx]=true;
