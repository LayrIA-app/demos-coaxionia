    if(s3)s3.style.display='none';
  }
  
  function ndLanzar(){
    var cliente=document.getElementById('nd-cliente');
    var sector=document.getElementById('nd-sector');
    if(!cliente||!cliente.value||!sector||!sector.value){
      if(typeof showToast==='function')showToast('Selecciona cliente y sector');
      return;
    }
    var s1=document.getElementById('nd-step1');
    var s2=document.getElementById('nd-step2');
    if(s1)s1.style.display='none';
    if(s2)s2.style.display='block';
    var steps=[
      [12,'Recopilando datos operativos del cliente'],
      [28,'Cruzando con benchmark sectorial'],
      [45,'Analizando patrones de proyectos similares'],
      [62,'Detectando señales de mercado externas'],
      [78,'Identificando gaps y oportunidades'],
      [91,'Calculando ROI potencial'],
      [100,'Generando informe ejecutivo']
    ];
    var i=0;
    function next(){
      if(i>=steps.length){
        setTimeout(function(){
          var s2b=document.getElementById('nd-step2');
          var s3=document.getElementById('nd-step3');
          if(s2b)s2b.style.display='none';
          if(s3)s3.style.display='block';
        },400);
        return;
      }
      var bar=document.getElementById('nd-pbar');
      var pct=document.getElementById('nd-ppct');
      var txt=document.getElementById('nd-ptxt');
      if(bar)bar.style.width=steps[i][0]+'%';
      if(pct)pct.textContent=steps[i][0]+'%';
      if(txt)txt.textContent=steps[i][1];
      i++;
      setTimeout(next,600);
    }
    next();
  }
  
  // Global function called from button
  window.abrirND=function(){
    ndInit();
    var ov=document.getElementById('nd-overlay');
    if(ov){
      ov.style.display='flex';
      // Reset to step1
      var s1=document.getElementById('nd-step1');
      var s2=document.getElementById('nd-step2');
      var s3=document.getElementById('nd-step3');
      if(s1)s1.style.display='block';
      if(s2)s2.style.display='none';
      if(s3)s3.style.display='none';
    }
  };
  window.cerrarND=function(){ndCerrar();};
  
  document.addEventListener('DOMContentLoaded',ndInit);
})();

function showToast(msg){
  var t=document.getElementById('stratia-toast');
  if(!t){
    t=document.createElement('div');
    t.id='stratia-toast';
    t.style.cssText='position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(60px);background:#1E4DB7;color:#fff;padding:10px 20px;border-radius:10px;font-size:.75rem;font-weight:600;z-index:9999;transition:transform .3s ease,opacity .3s ease;opacity:0;pointer-events:none;max-width:90vw;text-align:center;box-shadow:0 4px 20px rgba(30,77,183,.4)';
    document.body.appendChild(t);
  }
  t.textContent='\u2713 '+msg;
  t.style.transform='translateX(-50%) translateY(0)';
  t.style.opacity='1';
  clearTimeout(t._to);
  t._to=setTimeout(function(){t.style.transform='translateX(-50%) translateY(60px)';t.style.opacity='0';},2800);
}

// ── Portada: typewriter + contador ──
(function(){
  // Counter
  var el=document.getElementById('rs-counter-num');
  if(el){
    var target=247,dur=1200,t0=performance.now();
    function tick(t){var p=Math.min((t-t0)/dur,1);var e=1-Math.pow(1-p,3);el.textContent=Math.round(target*e);if(p<1)requestAnimationFrame(tick);else el.textContent=target;}
    requestAnimationFrame(tick);
  }
  // Typewriter
  var tw=document.getElementById('rs-tw-text');
  if(tw){
    var phrases=['Consultoría estratégica con IA adaptativa','Rentabilidad por proyecto y equipo','Diagnóstico de cliente en minutos','StratIA anticipa, tú decides'];
    var pi=0,ci=0,deleting=false;
    function typeTick(){
      var phrase=phrases[pi];
      if(!deleting){tw.textContent=phrase.substring(0,ci+1);ci++;if(ci===phrase.length){deleting=true;setTimeout(typeTick,1800);return;}setTimeout(typeTick,60);}
      else{tw.textContent=phrase.substring(0,ci-1);ci--;if(ci===0){deleting=false;pi=(pi+1)%phrases.length;setTimeout(typeTick,300);return;}setTimeout(typeTick,35);}
    }
    setTimeout(typeTick,600);
  }
})();

