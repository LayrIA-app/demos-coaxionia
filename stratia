// ===== SIMULADOR ROADMAP JS =====
function roadRecalc(){
  var vel=parseInt(document.getElementById('road-vel').value)||2;
  var rec=parseInt(document.getElementById('road-rec').value)||2;
  var pres=parseInt(document.getElementById('road-pres').value)||2;
  var lblsVel=['Lenta','Normal','Rapida'];
  var lblsRec=['Limitados','Medios','Amplios'];
  var lblsPres=['Ajustado','Medio','Amplio'];
  document.getElementById('road-vel-lbl').textContent=lblsVel[vel-1];
  document.getElementById('road-rec-lbl').textContent=lblsRec[rec-1];
  document.getElementById('road-pres-lbl').textContent=lblsPres[pres-1];
  var meses=Math.round(9-(vel-1)*1.5-(rec-1)*0.5);
  var roi=(2.8+(vel-1)*0.4+(rec-1)*0.3+(pres-1)*0.3).toFixed(1);
  var exito=Math.round(60+(vel-1)*8+(rec-1)*6+(pres-1)*5);
  document.getElementById('road-duracion').textContent=meses+' meses';
  document.getElementById('road-roi').textContent=roi+'x';
  document.getElementById('road-exito').textContent=Math.min(exito,97)+'%';
}

// ===== CALCULADORA DE IMPACTO JS =====
function impRecalc(){
  var areas=parseInt(document.getElementById('imp-areas').value)||3;
  var vel=parseInt(document.getElementById('imp-vel').value)||2;
  var sub=parseInt(document.getElementById('imp-sub').value)||1;
  var lblsVel=['Lenta','Normal','Rapida'];
  document.getElementById('imp-areas-val').textContent=areas;
  document.getElementById('imp-vel-val').textContent=lblsVel[vel-1];
  document.getElementById('imp-sub-val').textContent=sub?'Si':'No';
  var base=areas*52000;
  var velBonus=(vel-1)*18000;
  var total=base+velBonus;
  var inversion=areas*18000-sub*28000;
  var roi=(total/Math.max(inversion,1)).toFixed(1);
  var payback=(inversion/total*12).toFixed(1);
  document.getElementById('imp-roi').textContent=roi+'x';
  document.getElementById('imp-ahorro').textContent=Math.round(total/1000)+'k EUR';
  document.getElementById('imp-payback').textContent=Math.max(payback,0.5)+' anos';
  document.getElementById('imp-inv').textContent=Math.max(Math.round(inversion/1000),5)+'k EUR';
}
function simRecalc(){
  var nuevos=parseInt(document.getElementById('sim-nuevos').value)||0;
  var tarifa=parseInt(document.getElementById('sim-tarifa').value)||48;
  var consultores=parseInt(document.getElementById('sim-consultores').value)||0;
  var renovacion=parseInt(document.getElementById('sim-renovacion').value)||72;
  document.getElementById('sim-nuevos-val').textContent=nuevos;
  document.getElementById('sim-tarifa-val').textContent=tarifa+'k';
  document.getElementById('sim-consultores-val').textContent=consultores;
  document.getElementById('sim-renovacion-val').textContent=renovacion+'%';
  var baseIngresos=580;
  var extra=nuevos*tarifa;
  var renovBonus=(renovacion-72)*2.5;
  var costeCons=consultores*48;
  var total=Math.round(baseIngresos+extra+renovBonus-costeCons);
  var margen=Math.round(34+(consultores>0?-2:0)+(renovacion>80?2:0)+(tarifa>50?3:0));
  document.getElementById('sim-resultado').textContent=total+'k€';
  document.getElementById('sim-margen').textContent=margen+'%';
  var riesgo='';
  if(nuevos>=4&&consultores===0)riesgo='Capacidad del equipo al límite. Se recomienda 1 consultor adicional para mantener calidad.';
  else if(consultores>=3)riesgo='Coste fijo elevado. Asegurar pipeline antes de incorporar más de 2 consultores.';
  else if(renovacion<60)riesgo='Tasa de renovación baja. Revisar propuesta de valor y seguimiento postventa.';
  else riesgo='Escenario equilibrado. Sin alertas críticas detectadas por IA.';
  document.getElementById('sim-riesgo').textContent=riesgo;
}

function simOptimizar(){
  var el;
  el=document.getElementById('sim-nuevos');el.value=4;
  el=document.getElementById('sim-tarifa');el.value=55;
  el=document.getElementById('sim-consultores');el.value=1;
  el=document.getElementById('sim-renovacion');el.value=80;
  simRecalc();
}


