function h(tag,attrs,inner){return '<'+tag+(attrs?' '+attrs:'')+'>'+inner+'</'+tag+'>';}
function kpi(val,lbl,delta,dir){return '<div class="kpi risen"><div class="kpi-accent"></div><div class="kpi-val">'+val+'</div><div class="kpi-label">'+lbl+'</div><div class="kpi-delta '+dir+'">'+delta+'</div></div>';}
function badge(cls,txt){return '<span class="badge '+cls+'">'+txt+'</span>';}
function iabox(icon,txt){return '<div class="ia-box"><div class="ia-box-icon">'+icon+'</div><div class="ia-box-text">'+txt+'</div></div>';}
function alert_(type,icon,title,sub){return '<div class="alert alert-'+type+'"><div class="alert-icon">'+icon+'</div><div><div class="alert-title">'+title+'</div><div class="alert-sub">'+sub+'</div></div></div>';}
function pbar(label,sub,pct){return '<div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;margin-bottom:4px"><span style="font-size:.72rem;font-weight:600;color:var(--navy)">'+label+'</span><span style="font-size:.65rem;color:var(--text3)">'+sub+'</span></div><div class="pbar"><div class="pbar-fill" style="width:'+pct+'"></div></div></div>';}
