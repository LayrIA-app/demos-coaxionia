.com-bubble.own{align-self:flex-end;background:#1E4DB7;color:#fff;border-radius:14px 14px 3px 14px;}
.com-bubble.other{align-self:flex-start;background:#fff;color:rgba(13,27,53,.8);border:1px solid rgba(13,27,53,.08);border-radius:14px 14px 14px 3px;}
