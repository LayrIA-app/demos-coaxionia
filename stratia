<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StratIA — Consultoría Estratégica & Transformación Digital</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;font-family:'DM Sans',sans-serif;}

@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(1.5)}}
@keyframes scanline{0%{transform:translateY(-100%)}100%{transform:translateY(500%)}}
@keyframes blink{0%,100%{opacity:1}48%{opacity:1}50%{opacity:0}52%{opacity:1}}
@keyframes dataScroll{0%{transform:translateY(0)}100%{transform:translateY(-50%)}}
@keyframes holoGlow{0%,100%{box-shadow:0 0 0 1.5px rgba(0,220,255,.5),0 0 24px rgba(0,220,255,.12),0 12px 48px rgba(0,0,0,.6)}50%{box-shadow:0 0 0 1.5px rgba(0,220,255,.95),0 0 52px rgba(0,220,255,.28),0 12px 48px rgba(0,0,0,.6)}}

/* ══ PORTADA ══ */
#roleScreen{position:fixed;inset:0;z-index:500;background:#0D1B35;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;}
.rs-grid{position:absolute;inset:0;pointer-events:none;}
.rs-topbar{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#1E4DB7,#C8102E,#1E4DB7);}
.rs-diag{position:absolute;top:0;right:0;bottom:0;width:38%;background:#C8102E;clip-path:polygon(22% 0,100% 0,100% 100%,0% 100%);opacity:.9;}
.rs-diag2{position:absolute;top:0;right:0;bottom:0;width:38%;background:#A00E24;clip-path:polygon(24% 0,100% 0,100% 100%,2% 100%);opacity:.35;}
.rs-inner{display:flex;flex-direction:column;align-items:center;position:relative;z-index:1;width:100%;}
.rs-logo-wrap{display:flex;align-items:center;gap:14px;margin-bottom:8px;animation:fadeUp .5s ease both;}
.rs-logo-icon{width:52px;height:52px;border-radius:12px;background:#0D1B35;border:1.5px solid rgba(30,77,183,.4);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(30,77,183,.3);}
.rs-logo-text{font-family:'Montserrat',sans-serif;font-size:48px;font-weight:900;color:#fff;letter-spacing:.06em;}
.rs-logo-text span{color:#C8102E;}
.rs-subtitle{font-family:'Montserrat',sans-serif;font-size:.82rem;font-weight:600;color:rgba(255,255,255,.4);letter-spacing:.14em;text-transform:uppercase;margin-bottom:36px;animation:fadeUp .5s .1s ease both;}

/* ── Contenedor tarjetas ── */
.rs-cards{display:flex;gap:0;animation:fadeUp .5s .2s ease both;position:relative;align-items:center;height:240px;width:596px;}

/* ── Tarjeta base ── */
.rs-card{
  width:180px;height:200px;border-radius:18px;cursor:pointer;overflow:hidden;
  position:absolute;
  transition:transform .45s cubic-bezier(.4,0,.2,1),opacity .45s ease,box-shadow .45s ease;
}
.rs-card:nth-child(1){left:0;}
.rs-card:nth-child(2){left:208px;}
.rs-card:nth-child(3){left:416px;}
.rs-card:nth-child(1){background:#fff;border-radius:18px 18px 64px 18px;border-left:2px solid #1E4DB7;}
.rs-card:nth-child(2){background:#1E4DB7;border-radius:18px 18px 18px 64px;border-left:2px solid rgba(255,255,255,.35);}
.rs-card:nth-child(3){background:#0D1B35;border-left:2px solid #C8102E;border-radius:18px 18px 64px 18px;}

/* Contenido normal */
.rs-card-body{padding:28px 20px 64px;transition:opacity .3s;}
.rs-card:nth-child(1) .rs-card-body{background:#fff;}
.rs-card:nth-child(2) .rs-card-body{background:#1E4DB7;}
.rs-card:nth-child(3) .rs-card-body{background:#0D1B35;}
.rs-ico{width:46px;height:46px;border-radius:10px;margin-bottom:14px;display:flex;align-items:center;justify-content:center;}

.rs-cn{font-family:'Montserrat',sans-serif;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px;display:flex;align-items:center;gap:7px;}
.rs-cn-ico{width:18px;height:18px;border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.rs-card:nth-child(1) .rs-cn-ico{background:#EEF3FF;}
.rs-card:nth-child(2) .rs-cn-ico{background:rgba(255,255,255,.18);}
.rs-card:nth-child(3) .rs-cn-ico{background:rgba(200,16,46,.15);}
.rs-card:nth-child(1) .rs-cn{color:#0D1B35;}
.rs-card:nth-child(2) .rs-cn,.rs-card:nth-child(3) .rs-cn{color:#fff;}
.rs-cd{font-size:11px;line-height:1.65;}
.rs-card:nth-child(1) .rs-cd{color:#7A8899;}
.rs-card:nth-child(2) .rs-cd{color:rgba(255,255,255,.7);}
.rs-card:nth-child(3) .rs-cd{color:rgba(255,255,255,.55);}
.rs-cta{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);transition:opacity .3s;background:transparent;z-index:5;}



.rs-cta-txt{font-family:"Montserrat",sans-serif;font-size:11px;font-weight:900;color:#fff;letter-spacing:.2em;text-transform:uppercase;padding:13px 32px;border-radius:40px;display:block;white-space:nowrap;}  .rs-card:nth-child(1) .rs-cta-txt{background:#0D1B35;} .rs-card:nth-child(2) .rs-cta-txt{background:#0D1B35;} .rs-card:nth-child(3) .rs-cta-txt{background:#C8102E;}

/* ── Número de fondo + línea top ── */
.rs-card-num{position:absolute;top:4px;right:8px;font-family:'Montserrat',sans-serif;font-size:100px;font-weight:900;line-height:1;pointer-events:none;z-index:0;letter-spacing:-.04em;}
.rs-card:nth-child(1) .rs-card-num{color:rgba(30,77,183,.18);}
.rs-card:nth-child(2) .rs-card-num{color:rgba(255,255,255,.18);}
.rs-card:nth-child(3) .rs-card-num{color:rgba(200,16,46,.25);}
.rs-card-line{position:absolute;top:0;left:0;right:0;height:4px;border-radius:18px 18px 0 0;}
.rs-card:nth-child(1) .rs-card-line{background:linear-gradient(90deg,#1E4DB7,rgba(30,77,183,.2));}
.rs-card:nth-child(2) .rs-card-line{background:linear-gradient(90deg,rgba(255,255,255,.6),rgba(255,255,255,.1));}
.rs-card:nth-child(3) .rs-card-line{background:linear-gradient(90deg,#C8102E,rgba(200,16,46,.2));}
.rs-card-body{position:relative;z-index:1;}

/* ── Panel holograma (oculto por defecto) ── */
.rs-holo{display:none;position:absolute;inset:0;padding:14px;flex-direction:column;gap:7px;overflow:hidden;background:#0D1B35;}
.rs-holo-scan{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(0,220,255,.85),transparent);animation:scanline 1.6s linear infinite;pointer-events:none;z-index:5;}
.rs-holo-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,220,255,.03),rgba(0,100,180,.05));pointer-events:none;}
.rs-holo-top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(0,220,255,.18);padding-bottom:8px;}
.rs-holo-id{font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;color:rgba(0,220,255,.75);letter-spacing:.22em;text-transform:uppercase;}
.rs-holo-dot{width:6px;height:6px;border-radius:50%;background:#00DCFF;flex-shrink:0;animation:blink 1.1s ease-in-out infinite;}
.rs-holo-score{text-align:center;padding:5px 0;border-bottom:1px solid rgba(0,220,255,.12);}
.rs-holo-score-num{font-family:'Montserrat',sans-serif;font-size:26px;font-weight:900;color:#00DCFF;text-shadow:0 0 18px rgba(0,220,255,.45);}
.rs-holo-score-label{font-size:8px;color:rgba(255,255,255,.75);letter-spacing:.18em;text-transform:uppercase;margin-top:2px;}
.rs-holo-bars{display:flex;flex-direction:column;gap:5px;}
.rs-holo-bar-row{display:flex;align-items:center;gap:6px;}
.rs-holo-bar-lbl{font-size:8px;color:rgba(0,220,255,.45);letter-spacing:.1em;text-transform:uppercase;width:50px;flex-shrink:0;}
.rs-holo-bar-track{flex:1;height:3px;background:rgba(0,220,255,.08);border-radius:2px;overflow:hidden;}
.rs-holo-bar-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,rgba(0,220,255,.35),rgba(0,220,255,.85));}
.rs-holo-stream{flex:1;overflow:hidden;position:relative;}
.rs-holo-stream-inner{font-family:monospace;font-size:8px;color:rgba(0,220,255,.55);line-height:1.75;animation:dataScroll 5s linear infinite;}
.rs-holo-stream-inner b{color:rgba(0,220,255,.9);}
.rs-holo-role{font-family:'Montserrat',sans-serif;font-size:10px;font-weight:900;color:rgba(0,220,255,.8);letter-spacing:.18em;text-transform:uppercase;text-align:center;border-top:1px solid rgba(0,220,255,.15);padding-top:7px;text-shadow:0 0 10px rgba(0,220,255,.3);}

/* ── Efectos de hover ── */
/* Las NO seleccionadas se apilan detrás */
.rs-cards:has(.rs-card:nth-child(1):hover) .rs-card:nth-child(2){transform:translateX(-100px) scale(.8);opacity:.3;z-index:1;}
.rs-cards:has(.rs-card:nth-child(1):hover) .rs-card:nth-child(3){transform:translateX(-124px) scale(.74);opacity:.18;z-index:0;}
.rs-cards:has(.rs-card:nth-child(2):hover) .rs-card:nth-child(1){transform:translateX(100px) scale(.8);opacity:.3;z-index:1;}
.rs-cards:has(.rs-card:nth-child(2):hover) .rs-card:nth-child(3){transform:translateX(-100px) scale(.8);opacity:.3;z-index:1;}
.rs-cards:has(.rs-card:nth-child(3):hover) .rs-card:nth-child(1){transform:translateX(124px) scale(.74);opacity:.18;z-index:0;}
.rs-cards:has(.rs-card:nth-child(3):hover) .rs-card:nth-child(2){transform:translateX(100px) scale(.8);opacity:.3;z-index:1;}

/* La seleccionada — holograma */
.rs-card:hover{z-index:10;transform:scale(1.05) translateY(-6px) !important;animation:holoGlow 1.2s ease-in-out infinite;}
.rs-card:hover .rs-card-body{opacity:0;}
.rs-card:hover .rs-cta{opacity:0;}
.rs-card:hover .rs-holo{display:flex;}

/* Footer */
.rs-footer{position:absolute;bottom:0;left:0;right:0;padding:10px 28px;display:flex;align-items:center;justify-content:space-between;background:rgba(200,16,46,.04);border-top:1px solid rgba(200,16,46,.1);}
.rs-footer-txt{font-size:.44rem;letter-spacing:.2em;text-transform:uppercase;font-weight:600;color:rgba(255,255,255,.2);}
.rs-footer-dot{width:5px;height:5px;border-radius:50%;background:#C8102E;animation:pulse 1.8s ease-in-out infinite;}

/* ══ LOGIN ══ */
#loginScreen{display:none;position:fixed;inset:0;z-index:400;}
.login-wrap{display:flex;height:100%;}
.login-left{flex:1;background:#C8102E;display:flex;flex-direction:column;justify-content:center;padding:64px 72px;position:relative;overflow:hidden;}
.ll-pattern{position:absolute;inset:0;pointer-events:none;}
.ll-dark-overlay{position:absolute;top:0;left:0;bottom:0;width:40%;background:linear-gradient(90deg,rgba(0,0,0,.25),transparent);}
.ll-inner{position:relative;z-index:1;}
.ll-logo{display:flex;align-items:center;gap:12px;margin-bottom:8px;}
.ll-logo-icon{width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;}
.ll-logo-text{font-family:'Montserrat',sans-serif;font-size:28px;font-weight:900;color:#fff;letter-spacing:.06em;}
.ll-logo-text span{color:rgba(255,255,255,.6);}
.ll-role-pill{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-radius:20px;padding:5px 16px;margin:20px 0 16px;font-size:.72rem;font-weight:600;color:#fff;letter-spacing:.08em;text-transform:uppercase;}
.ll-inner h1{font-family:'Montserrat',sans-serif;font-size:2.2rem;font-weight:900;line-height:1.05;color:#fff;margin-bottom:14px;letter-spacing:-.01em;text-transform:uppercase;}
.ll-inner h1 em{color:#0D1B35;font-style:normal;}
.ll-inner p{color:rgba(255,255,255,.65);font-size:.9rem;line-height:1.75;max-width:400px;}
.ll-feats{margin-top:24px;display:flex;flex-direction:column;gap:10px;}
.ll-feat{display:flex;align-items:center;gap:10px;font-size:.78rem;color:rgba(255,255,255,.8);}
.ll-feat-bar{width:3px;height:14px;background:rgba(255,255,255,.5);border-radius:2px;flex-shrink:0;}
.ll-brand{position:absolute;bottom:28px;left:72px;font-size:.55rem;color:rgba(255,255,255,.25);letter-spacing:.16em;text-transform:uppercase;}
.login-right{width:460px;display:flex;flex-direction:column;justify-content:center;padding:64px 56px;background:#fff;border-left:1px solid #E0E8F4;}
.lr-eyebrow{font-size:.62rem;color:#8A9BB0;letter-spacing:.2em;text-transform:uppercase;margin-bottom:8px;}
.lr-title{font-family:'Montserrat',sans-serif;font-size:1.6rem;font-weight:900;color:#0D1B35;margin-bottom:32px;text-transform:uppercase;letter-spacing:.04em;}
.lr-title span{color:#C8102E;}
.lf-label{display:block;font-size:.6rem;font-weight:700;color:#8A9BB0;letter-spacing:.16em;text-transform:uppercase;margin-bottom:6px;}
.lf-input{width:100%;padding:13px 16px;background:#F4F7FC;border:1.5px solid #E0E8F4;border-radius:8px;color:#0D1B35;font-size:.88rem;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s,box-shadow .2s;margin-bottom:18px;}
.lf-input:focus{border-color:#C8102E;box-shadow:0 0 0 3px rgba(200,16,46,.08);}
.login-btn{width:100%;padding:14px;background:#0D1B35;border:none;border-radius:8px;color:#fff;font-family:'Montserrat',sans-serif;font-weight:900;font-size:.9rem;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 4px 20px rgba(13,27,53,.3);transition:all .2s;}
.login-btn:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(13,27,53,.4);}
.back-link{display:block;text-align:center;margin-top:16px;font-size:.75rem;color:#8A9BB0;cursor:pointer;transition:color .2s;}
.back-link:hover{color:#C8102E;}
/* ══ APP SHELL ══ */
:root{--blue:#1E4DB7;--red:#C8102E;--navy:#0D1B35;--cyan:#00C8FF;--green:#1a9e4a;--amber:#e8a010;--white:#fff;--bg:#F4F7FC;--border:#E0E8F4;--text1:#071830;--text2:#4A5A6A;--text3:#7a8899;}
#appShell{display:none;height:100vh;flex-direction:column;}
.topbar{height:52px;background:var(--navy);display:flex;align-items:center;padding:0 20px;gap:14px;flex-shrink:0;position:relative;}
.topbar::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--red),var(--blue));background-size:200% 100%;animation:borderRun 4s linear infinite;}
@keyframes borderRun{0%{background-position:0%}100%{background-position:200%}}
.topbar-logo{font-family:'Montserrat',sans-serif;font-size:18px;font-weight:900;color:#fff;letter-spacing:.06em;}
.topbar-logo span{color:var(--red);}
.topbar-role{font-size:.62rem;color:rgba(255,255,255,.4);letter-spacing:.16em;text-transform:uppercase;border-left:1px solid rgba(255,255,255,.1);padding-left:14px;margin-left:4px;}
.topbar-badge{margin-left:auto;font-size:.58rem;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(0,200,255,.1);color:var(--cyan);border:1px solid rgba(0,200,255,.2);letter-spacing:.08em;animation:pulseIA 2s ease-in-out infinite;}
@keyframes pulseIA{0%,100%{opacity:1}50%{opacity:.5}}
.shell-body{display:flex;flex:1;overflow:hidden;}
.sidebar{width:210px;flex-shrink:0;display:flex;flex-direction:column;padding:14px 10px;background:var(--white);border-right:1px solid var(--border);overflow-y:auto;}
.sidebar::-webkit-scrollbar{width:3px;}
.sidebar::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}
.sb-section{font-size:.55rem;font-weight:700;color:var(--text3);letter-spacing:.2em;text-transform:uppercase;padding:12px 8px 6px;margin-top:4px;}
.sb-btn{width:100%;display:flex;align-items:center;gap:8px;padding:9px 10px;border:none;background:transparent;border-radius:8px;cursor:pointer;font-size:.76rem;font-family:'DM Sans',sans-serif;font-weight:500;color:var(--text2);text-align:left;transition:all .15s,padding-left .15s;}
.sb-btn:hover{background:#F0F5FF;color:var(--blue);padding-left:14px;}
.sb-btn.active{background:#EEF3FF;color:var(--blue);font-weight:700;padding-left:14px;}
.sb-icon{font-size:14px;flex-shrink:0;}
.sb-ia-badge{margin-left:auto;font-size:.5rem;font-weight:700;padding:2px 5px;border-radius:3px;background:var(--blue);color:#fff;letter-spacing:.04em;animation:pulseIA 2s ease-in-out infinite;}
.sb-footer{margin-top:auto;padding-top:12px;border-top:1px solid var(--border);}
.sb-footer-btn{width:100%;padding:8px 10px;border:none;background:transparent;cursor:pointer;font-size:.72rem;font-family:'DM Sans',sans-serif;color:var(--text3);text-align:left;border-radius:6px;transition:all .15s;}
.sb-footer-btn:hover{background:#FEF0F0;color:var(--red);}
.content{flex:1;overflow-y:auto;padding:24px;background:var(--bg);}
.content::-webkit-scrollbar{width:4px;}
.content::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}
.screen{display:none;}
.screen.active{display:block;animation:fadeUp .22s ease both;}
.page-hdr{margin-bottom:20px;}
.page-hdr-line{display:flex;align-items:center;gap:10px;margin-bottom:4px;}
.page-hdr h2{font-family:'Montserrat',sans-serif;font-size:1.1rem;font-weight:900;color:var(--navy);text-transform:uppercase;letter-spacing:.04em;}
.page-hdr p{font-size:.78rem;color:var(--text2);line-height:1.6;}
.badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:.6rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
.b-blue{background:#EEF3FF;color:var(--blue);}
.b-red{background:#FDECEA;color:var(--red);}
.b-ok{background:#EBF5EF;color:var(--green);}
.b-amber{background:#FDF3E7;color:var(--amber);}
.b-navy{background:#EEF3FF;color:var(--navy);}
.b-cyan{background:rgba(0,200,255,.1);color:#0099CC;}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:16px;}
.mb14{margin-bottom:14px;}
.card{background:var(--white);border-radius:10px;padding:16px;border:1px solid var(--border);margin-bottom:0;position:relative;overflow:hidden;}
.card::after{content:'';position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-15deg);pointer-events:none;}
.card:hover::after{animation:kpiShine .5s ease forwards;}
.card-title{font-family:'Montserrat',sans-serif;font-size:.75rem;font-weight:800;color:var(--navy);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.card-title-ia{font-size:.5rem;font-weight:700;padding:2px 6px;border-radius:3px;background:var(--blue);color:#fff;letter-spacing:.04em;animation:pulseIA 2s ease-in-out infinite;}
.tbl{width:100%;border-collapse:collapse;font-size:.75rem;}
.tbl th{text-align:left;font-size:.6rem;font-weight:700;color:var(--text3);letter-spacing:.12em;text-transform:uppercase;padding:6px 8px;border-bottom:1.5px solid var(--border);}
.tbl td{padding:8px;border-bottom:1px solid var(--border);color:var(--text1);vertical-align:middle;}
.tbl tr:last-child td{border-bottom:none;}
.tbl tr:hover td{background:#F8FAFF;}
.ia-box{background:linear-gradient(135deg,rgba(30,77,183,.05),rgba(0,200,255,.06));border:1px solid rgba(30,77,183,.12);border-radius:10px;padding:11px 13px;display:flex;gap:9px;margin-top:13px;animation:iaFlash 1.4s ease both;}
@keyframes iaFlash{0%{border-color:var(--cyan);background:rgba(0,200,255,.08)}100%{border-color:rgba(30,77,183,.25);background:linear-gradient(135deg,rgba(30,77,183,.04),rgba(0,200,255,.06))}}
.ia-box-icon{font-size:14px;flex-shrink:0;}
.ia-box-text{font-size:.75rem;color:var(--text2);line-height:1.6;}
.alert{display:flex;gap:10px;padding:10px 12px;border-radius:8px;margin-bottom:8px;align-items:flex-start;}
.alert-red{background:#FEF5F5;}
.alert-amber{background:#FDF8EF;}
.alert-green{background:#EFF8F2;}
.alert-blue{background:#EEF3FF;}
.alert-icon{font-size:14px;flex-shrink:0;}
.alert-title{font-size:.75rem;font-weight:700;color:var(--text1);margin-bottom:2px;}
.alert-sub{font-size:.68rem;color:var(--text2);line-height:1.5;}
