      setTimeout(function(){
        document.getElementById('nd-step2').style.display='none';
        document.getElementById('nd-step3').style.display='block';
      },400);
      return;
    }
    var bar=document.getElementById('nd-progress-bar');
    var pct=document.getElementById('nd-progress-pct');
    var txt=document.getElementById('nd-progress-txt');
    bar.style.width=steps[i][0]+'%';
    pct.textContent=steps[i][0]+'%';
    txt.textContent=steps[i][1];
    i++;
    setTimeout(nextStep, 600);
  }
  nextStep();
}


