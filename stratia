/* ══ APP SHELL ══ */
:root{
  --blue:#1E4DB7;--red:#C8102E;--navy:#0D1B35;--cyan:#00C8FF;
  --green:#1a9e4a;--amber:#e8a010;--white:#fff;
  --bg:#EDF1F8;--border:#D8E2F0;--text1:#071830;--text2:#4A5A6A;--text3:#7a8899;
  --shadow-sm:0 2px 8px rgba(7,24,48,.08),0 1px 2px rgba(7,24,48,.06);
  --shadow-md:0 8px 24px rgba(7,24,48,.10),0 2px 6px rgba(7,24,48,.06);
  --shadow-lg:0 16px 48px rgba(7,24,48,.14),0 4px 12px rgba(7,24,48,.08);
  --shadow-kpi:0 4px 14px rgba(7,24,48,.09),0 1px 3px rgba(7,24,48,.07),inset 0 1px 0 rgba(255,255,255,.9);
  --shadow-card:0 4px 20px rgba(7,24,48,.08),0 1px 4px rgba(7,24,48,.05),inset 0 1px 0 rgba(255,255,255,.95);
  --shadow-hover:0 20px 50px rgba(7,24,48,.16),0 6px 16px rgba(30,77,183,.10),inset 0 1px 0 rgba(255,255,255,.95);
}
#appShell{display:none;height:100vh;flex-direction:column;}
.topbar{height:52px;background:var(--navy);display:flex;align-items:center;padding:0 20px;gap:14px;flex-shrink:0;position:relative;box-shadow:0 2px 12px rgba(0,0,0,.25);}
.topbar::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--red),var(--blue));background-size:200% 100%;animation:borderRun 4s linear infinite;}
@keyframes borderRun{0%{background-position:0%}100%{background-position:200%}}
.topbar-logo{font-family:'Montserrat',sans-serif;font-size:18px;font-weight:900;color:#fff;letter-spacing:.06em;}
.topbar-logo span{color:var(--red);}
.topbar-role{font-size:.62rem;color:rgba(255,255,255,.4);letter-spacing:.16em;text-transform:uppercase;border-left:1px solid rgba(255,255,255,.1);padding-left:14px;}
.topbar-badge{font-size:.58rem;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(0,200,255,.1);color:#00C8FF;border:1px solid rgba(0,200,255,.2);letter-spacing:.08em;animation:pulseIA 2s ease-in-out infinite;}
@keyframes pulseIA{0%,100%{opacity:1}50%{opacity:.5}}
.shell-body{display:flex;flex:1;overflow:hidden;}

/* ── Sidebar 3D ── */
.sidebar{width:210px;flex-shrink:0;display:flex;flex-direction:column;padding:14px 10px;
  background:linear-gradient(180deg,#fff 0%,#F8FAFF 100%);
  border-right:1px solid var(--border);overflow-y:auto;
  box-shadow:2px 0 12px rgba(7,24,48,.06);}
.sidebar::-webkit-scrollbar{width:3px;}
.sidebar::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}
.sb-section{font-size:.55rem;font-weight:700;color:var(--text3);letter-spacing:.2em;text-transform:uppercase;padding:12px 8px 6px;margin-top:4px;}
.sb-btn{width:100%;display:flex;align-items:center;gap:8px;padding:9px 10px;border:none;background:transparent;border-radius:8px;cursor:pointer;font-size:.76rem;font-family:'DM Sans',sans-serif;font-weight:500;color:var(--text2);text-align:left;transition:all .18s,padding-left .18s;}
.sb-btn:hover{background:linear-gradient(135deg,#EEF3FF,#F0F8FF);color:var(--blue);padding-left:14px;box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 1px 4px rgba(30,77,183,.08);}
.sb-btn.active{background:linear-gradient(135deg,#EEF3FF,#E8F0FF);color:var(--blue);font-weight:700;padding-left:14px;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 2px 6px rgba(30,77,183,.1);border-left:2px solid var(--blue);}
.sb-icon{font-size:14px;flex-shrink:0;}
.sb-ia-badge{margin-left:auto;font-size:.5rem;font-weight:700;padding:2px 5px;border-radius:3px;background:var(--blue);color:#fff;animation:pulseIA 2s ease-in-out infinite;}
.sb-footer{margin-top:auto;padding-top:12px;border-top:1px solid var(--border);}
.sb-footer-btn{width:100%;padding:8px 10px;border:none;background:transparent;cursor:pointer;font-size:.72rem;font-family:'DM Sans',sans-serif;color:var(--text3);text-align:left;border-radius:6px;transition:all .15s;}
.sb-footer-btn:hover{background:#FEF0F0;color:var(--red);}

/* ── Content area — atmospheric background ── */
.content{flex:1;overflow-y:auto;padding:24px;
  background:
    radial-gradient(ellipse 60% 40% at 80% 10%, rgba(30,77,183,.05) 0%, transparent 60%),
    radial-gradient(ellipse 50% 35% at 10% 80%, rgba(0,200,255,.04) 0%, transparent 55%),
    linear-gradient(160deg, #EDF1F8 0%, #E8EEF8 50%, #EAF0F9 100%);
  position:relative;z-index:1;}
.content::-webkit-scrollbar{width:5px;}
.content::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px;}

.screen{display:none;}
.screen.active{display:block;animation:fadeUp .22s ease both;}
.page-hdr{margin-bottom:20px;}
.page-hdr-line{display:flex;align-items:center;gap:10px;margin-bottom:4px;}
.page-hdr h2{font-family:'Montserrat',sans-serif;font-size:1.1rem;font-weight:900;color:var(--navy);text-transform:uppercase;letter-spacing:.04em;}
.page-hdr p{font-size:.78rem;color:var(--text2);line-height:1.6;}
.badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:.6rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
.b-blue{background:#EEF3FF;color:var(--blue);}
.b-red{background:#FDECEA;color:var(--red);}
.b-ok{background:#EBF5EF;color:var(--green);}
.b-amber{background:#FDF3E7;color:var(--amber);}
.b-navy{background:#EEF3FF;color:var(--navy);}
.b-blue-light{background:rgba(30,77,183,.08);color:var(--blue);}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px;}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:16px;}
.mb14{margin-bottom:16px;}

/* ══ KPI CARDS — FULL 3D ══ */
.kpi{
  background:linear-gradient(145deg,#ffffff 0%,#f8fbff 60%,#f2f7fe 100%);
  border-radius:14px;
  padding:16px 18px;
  border:1px solid rgba(255,255,255,.9);
  border-bottom:1px solid rgba(200,215,235,.6);
  position:relative;overflow:hidden;
  transform-style:preserve-3d;
  transition:transform .28s cubic-bezier(.4,0,.2,1.3),box-shadow .28s ease;
  opacity:0;cursor:default;
  box-shadow:var(--shadow-kpi);
}
/* Ambient occlusion inner shadow */
.kpi::before{
  content:'';position:absolute;inset:0;border-radius:14px;
  background:linear-gradient(135deg,rgba(255,255,255,.7) 0%,transparent 50%,rgba(7,24,48,.03) 100%);
  pointer-events:none;z-index:0;
}
/* Shine sweep */
.kpi::after{
  content:'';position:absolute;top:0;left:-70%;width:45%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.65),transparent);
  transform:skewX(-18deg);pointer-events:none;z-index:2;
}
.kpi:hover::after{animation:kpiShine .55s ease forwards;}
@keyframes kpiShine{0%{left:-70%}100%{left:140%}}
.kpi.risen{animation:kpiRise .65s cubic-bezier(.4,0,.2,1) forwards;}
.kpi.risen:nth-child(1){animation-delay:.05s}
.kpi.risen:nth-child(2){animation-delay:.15s}
.kpi.risen:nth-child(3){animation-delay:.25s}
.kpi.risen:nth-child(4){animation-delay:.35s}
@keyframes kpiRise{0%{opacity:0;transform:translateY(28px) scale(.96)}100%{opacity:1;transform:translateY(0) scale(1)}}
/* Top accent bar — grows on hover */
.kpi-accent{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:14px 14px 0 0;transform:scaleX(0);transform-origin:left;transition:transform .3s ease;}
.kpi:hover .kpi-accent{transform:scaleX(1);}
.kpi:hover{
  box-shadow:0 10px 28px rgba(7,24,48,.12),inset 0 1px 0 rgba(255,255,255,.9);
}
.kpi-val{font-family:'Montserrat',sans-serif;font-size:1.55rem;font-weight:900;color:var(--blue);line-height:1.1;margin-bottom:4px;position:relative;z-index:1;}
.kpi-label{font-size:.68rem;color:var(--text2);font-weight:500;position:relative;z-index:1;}
.kpi-delta{font-size:.62rem;margin-top:5px;font-weight:600;position:relative;z-index:1;}
.kpi-delta.up{color:var(--green);}
.kpi-delta.down{color:var(--red);}
.kpi-delta.neutral{color:var(--text3);}
.kpi-spark{display:block;margin-top:8px;width:100%;opacity:.6;}

/* ══ MAIN CARDS — FULL 3D ══ */
.card{
  background:linear-gradient(150deg,#ffffff 0%,#fafcff 70%,#f5f9fe 100%);
  border-radius:14px;
  padding:18px;
  border:1px solid rgba(255,255,255,.95);
  border-bottom:1px solid rgba(200,215,235,.5);
  position:relative;overflow:hidden;
  transition:transform .25s cubic-bezier(.4,0,.2,1.2),box-shadow .25s ease,border-color .2s;
  box-shadow:var(--shadow-card);
}
/* Top-left light reflection */
.card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:60%;
  background:linear-gradient(180deg,rgba(255,255,255,.55) 0%,transparent 100%);
  border-radius:14px 14px 0 0;pointer-events:none;z-index:0;
}
/* Shine sweep */
.card::after{
  content:'';position:absolute;top:0;left:-70%;width:40%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);
  transform:skewX(-15deg);pointer-events:none;z-index:2;
}
.card:hover::after{animation:kpiShine .5s ease forwards;}
.card:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 32px rgba(7,24,48,.11),0 3px 8px rgba(7,24,48,.07),inset 0 1px 0 rgba(255,255,255,.95);
  border-color:rgba(30,77,183,.12);
}
.card-title{font-family:'Montserrat',sans-serif;font-size:.75rem;font-weight:800;color:var(--navy);text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px;display:flex;align-items:center;gap:8px;position:relative;z-index:1;}
.card-title-ia{font-size:.5rem;font-weight:700;padding:2px 6px;border-radius:3px;background:var(--blue);color:#fff;animation:pulseIA 2s ease-in-out infinite;}

/* ── Table ── */
.tbl{width:100%;border-collapse:collapse;font-size:.75rem;position:relative;z-index:1;}
.tbl th{text-align:left;font-size:.6rem;font-weight:700;color:var(--text3);letter-spacing:.12em;text-transform:uppercase;padding:6px 8px;border-bottom:1.5px solid var(--border);}
.tbl td{padding:8px;border-bottom:1px solid rgba(224,232,244,.7);color:var(--text1);vertical-align:middle;transition:background .15s;}
.tbl tr:last-child td{border-bottom:none;}
.tbl tr:hover td{background:linear-gradient(90deg,rgba(238,243,255,.8),rgba(238,243,255,.4));}

/* ── IA box — glassmorphism sin borde lateral ── */
.ia-box{
  background:linear-gradient(135deg,rgba(30,77,183,.05),rgba(0,200,255,.06));
  border:1px solid rgba(30,77,183,.12);
  border-radius:10px;padding:11px 13px;
  display:flex;gap:9px;margin-top:13px;
  box-shadow:0 2px 10px rgba(30,77,183,.06),inset 0 1px 0 rgba(255,255,255,.8);
  animation:iaFlash 1.4s ease both;
  position:relative;z-index:1;
}
@keyframes iaFlash{0%{background:rgba(0,200,255,.1);box-shadow:0 0 14px rgba(0,200,255,.16)}100%{background:linear-gradient(135deg,rgba(30,77,183,.05),rgba(0,200,255,.06));box-shadow:0 2px 10px rgba(30,77,183,.06),inset 0 1px 0 rgba(255,255,255,.8)}}
.ia-box-icon{font-size:14px;flex-shrink:0;}
.ia-box-text{font-size:.75rem;color:var(--text2);line-height:1.6;}

/* ── Alerts — sin borde lateral, diseño limpio ── */
.alert{
  display:flex;gap:10px;padding:11px 14px;border-radius:10px;margin-bottom:8px;align-items:flex-start;
  transition:transform .18s,box-shadow .18s;
  border:1px solid transparent;
  position:relative;z-index:1;
}
.alert:hover{transform:translateX(2px);box-shadow:0 4px 16px rgba(7,24,48,.07);}
.alert-red{background:linear-gradient(135deg,#FEF5F5,#FDF0F0);border-color:rgba(200,16,46,.1);}
.alert-amber{background:linear-gradient(135deg,#FDF8EF,#FCF4E8);border-color:rgba(232,160,16,.12);}
.alert-green{background:linear-gradient(135deg,#EFF8F2,#EAF6ED);border-color:rgba(26,158,74,.12);}
.alert-blue{background:linear-gradient(135deg,#EEF3FF,#E8F0FF);border-color:rgba(30,77,183,.1);}
.alert-icon{font-size:13px;flex-shrink:0;margin-top:1px;}
.alert-title{font-size:.75rem;font-weight:700;color:var(--text1);margin-bottom:2px;}
.alert-sub{font-size:.68rem;color:var(--text2);line-height:1.5;}

/* ── Progress bar with animated dot ── */
.pbar{width:100%;height:6px;background:rgba(224,232,244,.7);border-radius:4px;overflow:visible;position:relative;box-shadow:inset 0 1px 3px rgba(7,24,48,.1);}
.pbar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--blue),var(--cyan));position:relative;transition:width .85s cubic-bezier(.4,0,.2,1);box-shadow:0 1px 4px rgba(30,77,183,.3);}
.pbar-fill::after{content:'';position:absolute;right:-4px;top:50%;transform:translateY(-50%);width:10px;height:10px;border-radius:50%;background:var(--cyan);box-shadow:0 0 7px var(--cyan),0 0 14px rgba(0,200,255,.5);animation:dotPulse 1.8s ease-in-out infinite;}
@keyframes dotPulse{0%,100%{box-shadow:0 0 7px var(--cyan),0 0 14px rgba(0,200,255,.4)}50%{box-shadow:0 0 12px var(--cyan),0 0 24px rgba(0,200,255,.7)}}

/* ── Btn 3D ── */
.btn{padding:8px 16px;border-radius:9px;border:none;cursor:pointer;font-family:'DM Sans',sans-serif;font-weight:700;font-size:.75rem;transition:all .2s;position:relative;z-index:1;}
.btn-blue{background:linear-gradient(145deg,#2a5cd4,var(--blue));color:#fff;box-shadow:0 4px 14px rgba(30,77,183,.3),0 1px 3px rgba(30,77,183,.2),inset 0 1px 0 rgba(255,255,255,.15);}
.btn-blue:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(30,77,183,.36),0 2px 6px rgba(30,77,183,.2);}
.btn-blue:active{transform:translateY(1px);box-shadow:0 2px 8px rgba(30,77,183,.2);}
.btn-sm{padding:5px 11px;font-size:.65rem;}

/* ── Particles canvas ── */
#particles-canvas{position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.45;}
.content{position:relative;z-index:1;}

/* ── Page header typewriter cursor ── */
.page-hdr h2 .tw-cursor{display:inline-block;width:2px;height:1em;background:var(--blue);margin-left:3px;vertical-align:text-bottom;animation:twBlink .7s step-end infinite;}
@keyframes twBlink{0%,100%{opacity:1}50%{opacity:0}}

/* ── Live data highlight pulse ── */
@keyframes dataHighlight{0%{background:rgba(0,200,255,.18)}100%{background:transparent}}
.data-fresh{animation:dataHighlight .8s ease forwards;}

/* ── Section reveal on scroll ── */
.reveal{opacity:0;transform:translateY(18px);transition:opacity .45s ease,transform .45s ease;}
.reveal.visible{opacity:1;transform:none;}

/* ── Orbs background ── */
.orb{position:fixed;border-radius:50%;filter:blur(80px);pointer-events:none;z-index:0;animation:orbDrift 12s ease-in-out infinite alternate;}
.orb1{width:320px;height:320px;background:rgba(30,77,183,.06);top:-80px;right:-60px;animation-delay:0s;}
.orb2{width:220px;height:220px;background:rgba(0,200,255,.04);bottom:60px;left:-40px;animation-delay:-4s;}
.orb3{width:180px;height:180px;background:rgba(200,16,46,.03);top:40%;right:20%;animation-delay:-8s;}
@keyframes orbDrift{0%{transform:translate(0,0) scale(1)}100%{transform:translate(30px,20px) scale(1.08)}}

