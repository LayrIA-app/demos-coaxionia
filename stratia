/* ── Portada: typewriter + contador + canales ── */
.rs-typewriter{font-family:'Montserrat',sans-serif;font-size:.9rem;font-weight:600;color:rgba(255,255,255,.6);letter-spacing:.06em;text-align:center;margin-bottom:10px;min-height:1.4em;}
