.com-bubble-sender{font-size:.55rem;font-weight:700;margin-bottom:3px;text-transform:uppercase;letter-spacing:.06em;}
.com-bubble-time{font-size:.52rem;margin-top:4px;text-align:right;opacity:.5;}
.com-input-row{display:flex;gap:8px;}
.com-input{flex:1;padding:10px 14px;border:1px solid rgba(13,27,53,.15);border-radius:8px;font-size:.7rem;outline:none;font-family:'Montserrat',sans-serif;}
.com-send-btn{padding:10px 18px;background:#1E4DB7;border:none;border-radius:8px;color:#fff;font-family:'Montserrat',sans-serif;font-size:.65rem;font-weight:700;cursor:pointer;transition:all .2s;}
.com-send-btn:hover{background:#0D1B35;}


/* ── Comunicacion responsive ── */
@media(max-width:700px){
  .com-grid{grid-template-columns:1fr!important;}
