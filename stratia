// Counters — número morphing desde 0
function animateCounters(){
  document.querySelectorAll('.screen.active .kpi-val').forEach(function(el){
    var txt=el.textContent.trim();
    var num=parseFloat(txt.replace(/[^0-9.-]/g,''));
    if(isNaN(num)||num===0) return;
    var prefix=txt.match(/^[^0-9-]*/)[0];
    var suffix=txt.match(/[^0-9.]+$/)?txt.match(/[^0-9.]+$/)[0]:'';
    var decimals=(txt.split('.')[1]||'').replace(/[^0-9]/g,'').length;
    var t0=performance.now();var dur=900;
    (function upd(now){
      var p=Math.min((now-t0)/dur,1);var e=1-Math.pow(1-p,3);
      el.textContent=prefix+(num*e).toFixed(decimals)+suffix;
      if(p<1) requestAnimationFrame(upd); else el.textContent=txt;
    })(performance.now());
  });
}

