function screen(id,active,content){return '<div class="screen'+(active?' active':'')+'" id="screen-'+id+'">'+content+'</div>';}
function phdr(title,badgeCls,badgeTxt,sub){return '<div class="page-hdr"><div class="page-hdr-line"><h2>'+title+'</h2>'+badge(badgeCls,badgeTxt)+'</div><p>'+sub+'</p></div>';}




