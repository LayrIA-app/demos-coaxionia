function buildClienteHTML(){
  var o='';
  function kpi(val,lbl,delta,dir){
  var sc=dir==='up'?'var(--blue)':'var(--red)';
  var pts=dir==='up'?'0,20 13,16 26,13 39,8 52,5 66,2':'0,2 13,5 26,9 39,13 52,16 66,20';
  var sp='<svg class="kpi-spark" viewBox="0 0 66 22" height="22"><polyline points="'+pts+'" fill="none" stroke="'+sc+'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  return '<div class="kpi risen"><div class="kpi-accent"></div><div class="kpi-val">'+val+'</div><div class="kpi-label">'+lbl+'</div><div class="kpi-delta '+dir+'">'+delta+'</div>'+sp+'</div>';
}
  function badge(cls,txt){return '<span class="badge '+cls+'">'+txt+'</span>';}
  function iabox(icon,txt){return '<div class="ia-box"><div class="ia-box-icon">'+icon+'</div><div class="ia-box-text">'+txt+'</div></div>';}
